# Copy to .env before running docker compose.

# --- Required for anything networked -----------------------------------------
# Agents must send `Authorization: Bearer <this>`. Without it the endpoint is
# open: anyone who can reach the port can read AND write your brain.
# Generate one:  openssl rand -hex 32
OPEN_INDEX_TOKEN=

# --- Which brain to serve ----------------------------------------------------
# Host path to your brain directory (contains brain.yaml). Created with
# `open-index init my-brain`.
BRAIN_DIR=./brain

# --- Ports -------------------------------------------------------------------
PORT=8080
UI_PORT=8501

# --- Remote / proxied deployments --------------------------------------------
# The URL agents actually connect to. Compose defaults this to
# http://localhost:$PORT/mcp, because inside a container auto-detection finds the
# container's bridge address, which nothing outside the compose network can
# reach. Set it explicitly when the brain is behind nginx, a tunnel, a load
# balancer, or on a remote host — it is what the startup banner and
# `open-index mcp-config` tell people to connect to.
# OPEN_INDEX_PUBLIC_URL=https://brain.acme.internal/mcp

# --- Search backend ----------------------------------------------------------
# Normally set by the compose profile you pick (--profile sqlite | opensearch).
# Only needed here for the standalone `ui` service.
# OPEN_INDEX_SEARCH_BACKEND=sqlite
# OPEN_INDEX_OPENSEARCH_HOSTS=http://opensearch:9200

# --- Semantic search (optional) ----------------------------------------------
# Leave unset to use the bundled local model (BAAI/bge-small-en-v1.5, 384-D),
# or point at any OpenAI-compatible embeddings API.
# OPEN_INDEX_EMBEDDING_BASE_URL=https://api.openai.com/v1
# OPEN_INDEX_EMBEDDING_API_KEY=
# OPEN_INDEX_EMBEDDING_MODEL=text-embedding-3-small
# OPEN_INDEX_EMBEDDING_DIM=1536
